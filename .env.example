# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# RevenueCat public SDK keys
# iOS can fall back to the existing checked-in key, but keeping both here makes builds explicit.
REVENUECAT_API_KEY_IOS=appl_your_ios_revenuecat_key_here
REVENUECAT_API_KEY_ANDROID=goog_your_android_revenuecat_key_here
